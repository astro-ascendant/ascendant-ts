{
  "name": "astro-ascendant",
  "displayName": "ascendant",
  "version": "5.1.1",
  "description": "Effect-Native TypeScript library for sidereal astrology calculations.",
  "keywords": [
    "ashtakavarga",
    "astrology",
    "chart",
    "dasha",
    "effect",
    "ephemeris",
    "jaimini",
    "sidereal",
    "transit",
    "vedic"
  ],
  "homepage": "https://astro-ascendant.vercel.app",
  "bugs": {
    "url": "https://github.com/astro-ascendant/ascendant-ts/issues"
  },
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Laxman K R",
    "email": "krlaxman03@gmail.com",
    "url": "https://thaletto.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astro-ascendant/ascendant-ts.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./chart": {
      "types": "./dist/chart/index.d.ts",
      "import": "./dist/chart/index.js"
    },
    "./chart/divisional-mapping": {
      "types": "./dist/chart/divisional-mapping/index.d.ts",
      "import": "./dist/chart/divisional-mapping/index.js"
    },
    "./dasha": {
      "types": "./dist/dasha/index.d.ts",
      "import": "./dist/dasha/index.js"
    },
    "./dasha/chara": {
      "types": "./dist/dasha/chara/index.d.ts",
      "import": "./dist/dasha/chara/index.js"
    },
    "./dasha/sthira": {
      "types": "./dist/dasha/sthira/index.d.ts",
      "import": "./dist/dasha/sthira/index.js"
    },
    "./dasha/vimshottari": {
      "types": "./dist/dasha/vimshottari/index.d.ts",
      "import": "./dist/dasha/vimshottari/index.js"
    },
    "./ephemeris": {
      "types": "./dist/ephemeris/index.d.ts",
      "import": "./dist/ephemeris/index.js"
    },
    "./provenance": {
      "types": "./dist/provenance.d.ts",
      "import": "./dist/provenance.js"
    },
    "./sav": {
      "types": "./dist/sav/index.d.ts",
      "import": "./dist/sav/index.js"
    },
    "./transit": {
      "types": "./dist/transit/index.d.ts",
      "import": "./dist/transit/index.js"
    },
    "./astro-params": {
      "types": "./dist/astro-params/index.d.ts",
      "import": "./dist/astro-params/index.js"
    },
    "./argala": {
      "types": "./dist/jaimini/argala/index.d.ts",
      "import": "./dist/jaimini/argala/index.js"
    },
    "./arudha-pada": {
      "types": "./dist/jaimini/arudha-pada/index.d.ts",
      "import": "./dist/jaimini/arudha-pada/index.js"
    },
    "./chara-karakas": {
      "types": "./dist/jaimini/chara-karakas/index.d.ts",
      "import": "./dist/jaimini/chara-karakas/index.js"
    },
    "./karakamsha": {
      "types": "./dist/jaimini/karakamsha/index.d.ts",
      "import": "./dist/jaimini/karakamsha/index.js"
    },
    "./rashi-drishti": {
      "types": "./dist/jaimini/rashi-drishti/index.d.ts",
      "import": "./dist/jaimini/rashi-drishti/index.js"
    },
    "./upapada": {
      "types": "./dist/jaimini/upapada/index.d.ts",
      "import": "./dist/jaimini/upapada/index.js"
    },
    "./swisseph": {
      "types": "./dist/swisseph/index.d.ts",
      "import": "./dist/swisseph/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "sh .githooks/install.sh && effect-tsgo patch --typescript --oxlint",
    "dev": "bun --watch src/index.ts",
    "example": "bun examples/index.ts",
    "benchmark": "bun benchmarks/cli.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "release": "bun run build && changeset publish",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "bun run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --fix --disable-nested-config",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "docgen": "docgen",
    "package:check": "bun run build && tsc -p tsconfig.package.json && bun tests/package/runtime.mjs && bun pm pack --dry-run",
    "check": "bun run typecheck && bun run test && bun run lint && bun run format:check && bun run build"
  },
  "dependencies": {
    "@swisseph/node": "^1.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@effect/docgen": "^4.1.0",
    "@effect/platform-bun": "^4.1.0",
    "@effect/tsgo": "0.47.2",
    "@effect/vitest": "^4.1.0",
    "effect": "^4.1.0",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "trustedDependencies": [
    "@swisseph/node"
  ]
}
