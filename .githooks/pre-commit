#!/bin/sh
# pre-commit guard: refuse to commit a file larger than MAX_FILE_TOKENS.
#
# Tokens are estimated as bytes / 4, the rough proxy for English and source
# code. The size is read from the staged blob rather than the working tree, so
# partial staging cannot smuggle a large file past the guard, and only the
# files this commit changes are inspected.
#
# Files whose size no author chose - lockfiles, legal boilerplate, vendored
# trees, build output, binaries - are skipped.
#
# Raise the limit for one commit:  MAX_FILE_TOKENS=20000 git commit ...
# Bypass the guard entirely:       git commit --no-verify
#
# Registered with git by .githooks/install.sh (core.hooksPath).

MAX_FILE_TOKENS=${MAX_FILE_TOKENS:-5000}
MAX_FILE_BYTES=$((MAX_FILE_TOKENS * 4))

# True when the path's size is machine-written, vendored, or not text at all.
is_ignored() {
	path=$1
	base=${path##*/}

	# Lockfiles and legal boilerplate.
	case "$base" in
	bun.lock | bun.lockb | package-lock.json | npm-shrinkwrap.json | yarn.lock | pnpm-lock.yaml)
		return 0
		;;
	Cargo.lock | poetry.lock | uv.lock | composer.lock | Gemfile.lock | flake.lock)
		return 0
		;;
	LICENSE | LICENSE.md | LICENSE.txt | COPYING)
		return 0
		;;
	# Rewritten wholesale by `changeset version`.
	CHANGELOG.md)
		return 0
		;;
	esac

	case "$path" in
	# Dependencies, vendored subtrees, build output, generated API docs.
	node_modules/* | */node_modules/*)
		return 0
		;;
	repos/* | dist/* | */dist/* | coverage/*)
		return 0
		;;
	docs/api/* | docs/swisseph/*)
		return 0
		;;
	# Bundled, minified, mapped, or emitted by a compiler.
	*.min.js | *.min.css | *.map | *.tsbuildinfo)
		return 0
		;;
	*.gen.ts | *.gen.tsx | *.generated.* | Generated.ts | */Generated.ts)
		return 0
		;;
	*/generated/* | */__generated__/* | */codegen/*)
		return 0
		;;
	# Assets, fonts, and archives.
	*.png | *.jpg | *.jpeg | *.gif | *.webp | *.avif | *.ico | *.svg)
		return 0
		;;
	*.woff | *.woff2 | *.ttf | *.otf | *.eot | *.pdf | *.mp4 | *.webm)
		return 0
		;;
	*.wasm | *.zip | *.gz | *.tgz)
		return 0
		;;
	esac

	return 1
}

check_file() {
	path=$1
	[ -n "$path" ] || return 0

	if is_ignored "$path"; then
		return 0
	fi

	# Skip anything that is not a staged blob (submodule gitlink, deletion).
	size=$(git cat-file -s ":$path" 2>/dev/null) || return 0

	# Most staged files are small: one index lookup settles them.
	if [ "$size" -le "$MAX_FILE_BYTES" ]; then
		return 0
	fi

	# A binary file has no meaningful token count, so it is never over the
	# limit. A NUL byte in the first 8 KiB marks it, which is where git draws
	# the same line.
	raw=$(git cat-file blob ":$path" 2>/dev/null | head -c 8192 | wc -c)
	text=$(git cat-file blob ":$path" 2>/dev/null | head -c 8192 | tr -d '\000' | wc -c)
	if [ "$raw" != "$text" ]; then
		return 0
	fi

	tokens=$((size / 4))
	{
		printf 'pre-commit: %s is about %s tokens (%s bytes), over the %s token limit.\n' \
			"$path" "$tokens" "$size" "$MAX_FILE_TOKENS"
		printf 'pre-commit: split it into smaller files, or send it through with `git commit --no-verify`.\n'
	} >&2
	return 1
}

# xargs re-invokes this script once per path so filenames containing spaces or
# newlines survive the trip from git.
if [ "${1:-}" = "--check-file" ]; then
	check_file "${2:-}"
	exit $?
fi

if ! git diff --cached --name-only --diff-filter=ACMR -z | xargs -0 -n 1 "$0" --check-file; then
	echo "pre-commit: refusing to commit files that exceed the token limit." >&2
	exit 1
fi

exit 0
