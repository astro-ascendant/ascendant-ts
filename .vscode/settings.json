{
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/typescript/bin",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.additionalLocations": ["./node_modules/typescript/bin"],

  "files.exclude": {
    ".github": true,
    ".gitignore": true,
    ".zed": true,
    ".vscode": true,
    "bun.lock": true,
    "CODE_OF_CONDUCT.md": true,
    "dist": true,
    "node_modules": true,
    "repos/**": true,
    "AGENTS.md": true,
    ".oxfmtrc.json": true,
    "LICENSE": true,
    "tsconfig.*": true,
    "vitest.*": true,
    "Makefile": true,
  },

  "js/ts.preferences.autoImportFileExcludePatterns": ["repos/**"],

  "files.watcherExclude": {
    "repos/**": true
  },

  "search.exclude": {
    "repos/**": true
  }
}
